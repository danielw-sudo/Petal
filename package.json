{
  "name": "petalgen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node -e \"const fs=require('fs');['dist/client/library','dist/client/trends'].forEach(p=>{if(fs.existsSync(p)){fs.rmSync(p,{recursive:true});console.log('cleaned',p)}})\"",
    "build": "astro build",
    "preview": "astro preview",
    "pages:dev": "wrangler pages dev dist --compatibility-date=2026-05-26 --binding D1_DATABASE=PETALGEN_DB --local",
    "db:bootstrap": "wrangler d1 execute PETALGEN_DB --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.5",
    "astro": "^6.3.8"
  }
}
