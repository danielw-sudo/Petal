---
// Footer.astro — shared site footer
---
<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-powered">
      Powered by
      <a href="https://pollinations.ai" target="_blank" rel="noopener noreferrer">
        🌸 Pollinations.ai
      </a>
    </span>

    <span class="footer-copy">
      © 2026
      <a href="https://github.com/danielw-sudo" target="_blank" rel="noopener noreferrer" class="footer-author">
        Danielw-sudo
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="vertical-align: -2px; margin-left: 3px;">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </span>

    <a href="/policy" class="footer-tou">Terms of Use</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 2px solid var(--border-strong);
    padding: 14px 24px;
    margin-top: auto;
  }
  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .footer-powered,
  .footer-powered a {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
  }
  .footer-powered a:hover { color: var(--text-secondary); text-decoration: underline; }
  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .footer-author {
    color: var(--text-secondary);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease;
  }
  .footer-author:hover { color: var(--text-primary); }
  .footer-tou {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
  }
  .footer-tou:hover { color: var(--text-secondary); text-decoration: underline; }
</style>
