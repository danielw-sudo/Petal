---
export const prerender = false;
const error = new URL(Astro.request.url).searchParams.get("error");
---
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>PetalGen Admin</title>
  <link rel="icon" type="image/png" sizes="96x96" href="/icons/icon-96x96.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48x48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180x180.png" />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: #fdf8f1; color: #1a1209; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .card { background: #fff; border: 2px solid #1a1209; border-radius: 4px; padding: 36px 32px; width: 100%; max-width: 360px; box-shadow: 4px 4px 0 #1a1209; }
    h1 { font-family: 'Press Start 2P', monospace; font-size: 0.75rem; letter-spacing: 0.05em; margin-bottom: 24px; }
    label { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #666; display: block; margin-bottom: 6px; }
    input[type="password"] { width: 100%; padding: 9px 12px; border: 2px solid #1a1209; border-radius: 3px; font-size: 0.9rem; font-family: inherit; background: #fdf8f1; outline: none; margin-bottom: 16px; }
    input[type="password"]:focus { border-color: #c05a2e; }
    button { width: 100%; padding: 10px; background: #1a1209; color: #fdf8f1; border: none; border-radius: 3px; font-size: 0.85rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    button:hover { background: #c05a2e; }
    .error { font-size: 0.78rem; color: #c05a2e; margin-bottom: 14px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>⚙ Admin</h1>
    {error && <p class="error">Incorrect password — try again.</p>}
    <form method="POST" action="/api/admin/auth">
      <label for="secret">Password</label>
      <input id="secret" type="password" name="secret" autofocus autocomplete="current-password" />
      <button type="submit">Sign in →</button>
    </form>
  </div>
</body>
</html>
